# Canonical production origin. Leave unset to use the current Vercel domain.
NEXT_PUBLIC_SITE_URL=https://serviceiphonebandung.vercel.app
# Set only after the confirmed custom domain has working DNS and HTTPS.
# Comma-separated old hostnames; destination is NEXT_PUBLIC_SITE_URL.
SEO_REDIRECT_HOSTS=
# Optional GA4 measurement ID; unset = no Google Analytics scripts/events.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
